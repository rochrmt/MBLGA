# ─── Connexion MySQL ──────────────────────────────────────────────────────────
DB_SERVER=localhost
DB_PORT=3306
DB_NAME=ageo
DB_USER=root
DB_PASSWORD=

# ─── Authentification ────────────────────────────────────────────────────────
# Changer cette valeur par une chaîne aléatoire longue et secrète
JWT_SECRET=changez_cette_valeur_par_une_chaine_aleatoire_Longue
JWT_EXPIRES=10h

# ─── Serveur ────────────────────────────────────────────────────────────────
PORT=3001

# ─── Licence ─────────────────────────────────────────────────────────────────
# Secret PROPRE à votre installation — sert à signer/vérifier vos clés de licence.
LICENCE_SECRET=changez_ce_secret_par_une_longue_chaine_aleatoire

# Clé de licence signée. Laissez vide pour le "mode interne" (app utilisable).
LICENCE_KEY=

# ─── Email (rappels de paiement) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=mot_de_passe_application
SMTP_FROM=votre.email@gmail.com
